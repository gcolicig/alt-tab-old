{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer-ch.local/schemas/verification-report.schema.json",
  "title": "humanizer-ch deterministic verification report",
  "type": "object",
  "required": ["schema", "status", "gate_status", "profile", "generated_at", "duration_ms", "environment", "contract_versions", "counts", "tests", "diagnostics"],
  "properties": {
    "schema": {"const": "humanizer-ch-verification-report@1"},
    "status": {"enum": ["passed", "failed"]},
    "gate_status": {"enum": ["passed", "incomplete", "failed"]},
    "profile": {"const": "deterministic"},
    "generated_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "contract_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "corpus_revision": {"type": ["string", "null"]},
    "routing_profile": {"type": ["string", "null"]},
    "model_revisions": {"type": "object"},
    "metrics": {"type": "object"},
    "counts": {
      "type": "object",
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "tests": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "skipped"]},
        "duration_ms": {"type": "number", "minimum": 0},
        "detail": {"type": "string"}
        ,"required_for_release": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
